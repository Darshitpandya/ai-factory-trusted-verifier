# Trusted verifier — SEPARATE credentials from factory producer
# This service must be independently deployed and owned.

# Verifier GitHub App (separate App from the factory producer App)
VERIFIER_APP_ID=REPLACE
VERIFIER_APP_PRIVATE_KEY_PATH=/run/secrets/verifier_app_key
VERIFIER_WEBHOOK_SECRET=REPLACE

# Verifier PostgreSQL (separate DB from coordinator)
VERIFIER_DATABASE_URL=postgresql://verifier:verifier@localhost:5433/verifier

# Server
VERIFIER_PORT=3002
VERIFIER_HOST=0.0.0.0

# oasdiff binary path (pinned in Docker image)
OASDIFF_BINARY=/usr/local/bin/oasdiff

# Allowed repositories (comma-separated OWNER/REPO)
ALLOWED_REPOS=OWNER/factory-reference-billing-api,OWNER/factory-reference-notification-api
